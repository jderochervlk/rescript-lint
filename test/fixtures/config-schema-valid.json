{
  "$schema": "../../npm/config.schema.json",
  "rules": {"no-optional-some": true, "no-console": false},
  "overrides": [{"paths": ["src", "test/A.resi"], "rules": {"max-lines": false}}],
  "root": ".",
  "reanalyzeReport": "report.json",
  "jsxRuntime": "react-dom",
  "testFramework": "rescript-vitest-3",
  "throwsRuntime": "rescript-12.3.1",
  "throwsDependencies": ["node_modules/example"],
  "restrictedModules": ["Internal"],
  "restrictions": [{"kind": "type", "path": "Api.t", "message": "Use the public type.", "url": "https://example.com/types"}],
  "entryModules": ["Main"],
  "exclude": ["generated"],
  "license": "MIT",
  "warningComments": {"terms": ["TODO", "REVIEW_ME"], "allowedContexts": ["documentation"]},
  "maxNesting": 0,
  "maxParams": 1,
  "maxLinesPerFunction": 2,
  "maxNestedDescribe": 3,
  "maxLines": 4,
  "maxSwitchCases": 5,
  "deepEqualityThreshold": 2
}
